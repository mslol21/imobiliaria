# ==============================================================================
# CONFIGURAÇÃO SUPABASE (OBRIGATÓRIO PARA PERSISTÊNCIA REAL E AUTENTICAÇÃO)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Chave privada exclusiva do servidor (NUNCA expor com NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui

# ==============================================================================
# CONFIGURAÇÕES PÚBLICAS DA PLATAFORMA
# ==============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEV_PREVIEW_DATA=true
